# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://localhost:27017/ashok-goel-library

# JWT Secrets (generate strong random strings)
JWT_SECRET=your-student-jwt-secret-change-this
JWT_ADMIN_SECRET=your-admin-jwt-secret-change-this

# Google OAuth 2.0 Client ID
# Create at: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Root Admin Credentials (used by seed script)
ADMIN_ROOT_USERNAME=root
ADMIN_ROOT_PASSWORD=change-this-strong-password

# Frontend URLs (for CORS)
STUDENT_FRONTEND_URL=http://localhost:3000
ADMIN_FRONTEND_URL=http://localhost:3001

# Cookie Domain (use localhost for dev)
COOKIE_DOMAIN=localhost
